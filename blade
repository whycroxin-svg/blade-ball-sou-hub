-- Top klasörünü al
local function getBallsFolder()
    return workspace:FindFirstChild("Balls")
end

-- Gerçek topu bul
local function getRealBall()
    local ballsFolder = getBallsFolder()
    if not ballsFolder then return nil end
    for _, ball in ipairs(ballsFolder:GetChildren()) do
        if ball:GetAttribute("realBall") then
            return ball
        end
    end
    return nil
end

-- Topun hedefi ben miyim?
local function isTargeted()
    local char = LocalPlayer.Character
    if not char then return false end
    -- Yöntem 1: Karakterde Highlight
    if char:FindFirstChild("Highlight") then return true end
    -- Yöntem 2: Topun target attribute
    local ball = getRealBall()
    if ball then
        local target = ball:GetAttribute("target")
        if target and (target == LocalPlayer.Name or target == LocalPlayer) then
            return true
        end
    end
    return false
end

-- Parry tetikleme
local lastParryTime = 0
local function triggerParry()
    local now = tick()
    if now - lastParryTime < Settings.ParryBekleme then return end
    lastParryTime = now
    
    if Settings.ParryModu == "Remote Fire" then
        pcall(function()
            local remotes = ReplicatedStorage:FindFirstChild("Remotes")
            if remotes then
                local parryRemote = remotes:FindFirstChild("ParryButtonPress")
                if parryRemote then
                    parryRemote:FireServer()
                end
            end
        end)
    else
        -- Mouse tıklama simülasyonu
        pcall(function()
            VirtualInputManager:SendMouseButtonEvent(0, 0, 0, true, game, 0)
            task.wait(0.02)
            VirtualInputManager:SendMouseButtonEvent(0, 0, 0, false, game, 0)
        end)
    end
    
    Settings.ParrySayisi = Settings.ParrySayisi + 1
end

-- Parry döngüsü
task.spawn(function()
    while task.wait(0.01) do
        if not Settings.AutoParry then continue end
        local char = LocalPlayer.Character
        if not char then continue end
        local hrp = char:FindFirstChild("HumanoidRootPart")
        if not hrp then continue end
        
        local ball = getRealBall()
        if not ball then continue end
        
        -- Hedef kontrolü
        if Settings.HedefUyariGoster and not isTargeted() then
            -- Top hedefte değil, yine de zaman hesapla
        end
        
        local ballPos = ball.Position
        local ballVel = ball.AssemblyLinearVelocity
        local ballSpeed = ballVel.Magnitude
        if ballSpeed < 1 then continue end
        
        -- Top bana geliyor mu? (yön kontrolü)
        local toPlayer = (hrp.Position - ballPos)
        local dotProduct = ballVel.Unit:Dot(toPlayer.Unit)
        if dotProduct < 0.5 then continue end -- top bana gelmiyor
        
        -- Zaman hesaplama
        local distance = toPlayer.Magnitude
        local timeToImpact = distance / ballSpeed
        
        if timeToImpact <= Settings.ParryMesafesi then
            triggerParry()
            if Settings.HedefUyariGoster then
                -- Uyarı ver
            end
        end
    end
end)

