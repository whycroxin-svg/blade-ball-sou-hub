-- Top tespit fonksiyonu
local function isRealBall(ball)
    if not ball or not ball:IsA("BasePart") then return false end
    if not Balls or not ball:IsDescendantOf(Balls) then return false end
    local realBall = ball:GetAttribute("realBall")
    return realBall == true
end

-- Hedef topu bul
local function getTargetBall()
    if not Balls then return nil end
    for _, ball in ipairs(Balls:GetChildren()) do
        if isRealBall(ball) then
            local target = ball:GetAttribute("target")
            if target == LocalPlayer.Name then
                return ball
            end
        end
    end
    return nil
end

-- Parry fonksiyonu (coklu yontem)
local function doParry()
    -- Yontem 1: VirtualInputManager ile mouse click
    pcall(function()
        VirtualInputManager:SendMouseButtonEvent(0, 0, 2, true, game, 0)
        task.wait(0.01)
        VirtualInputManager:SendMouseButtonEvent(0, 0, 0, false, game, 0)
    end)
    
    -- Yontem 2: Remote event dene
    pcall(function()
        local Remotes = ReplicatedStorage:FindFirstChild("Remotes")
        if Remotes then
            local ParryRemote = Remotes:FindFirstChild("ParryButtonPress") 
                          or Remotes:FindFirstChild("Parry")
            if ParryRemote then
                if ParryRemote:IsA("RemoteEvent") then
                    ParryRemote:FireServer()
                end
            end
        end
    end)
end

-- Auto Parry dongu
local autoParryConn = nil
local lastParryTime = 0

local function startAutoParry()
    if autoParryConn then return end
    autoParryConn = RunService.Heartbeat:Connect(function()
        if not Settings.AutoParry then return end
        if not LocalPlayer.Character then return end
        local HRP = LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
        if not HRP then return end
        
        local ball = getTargetBall()
        if ball then
            local dist = (ball.Position - HRP.Position).Magnitude
            local vel = ball.AssemblyLinearVelocity
            local speed = vel.Magnitude
            if speed > 1 and dist <= Settings.AutoParryRange then
                local timeToImpact = dist / speed
                if timeToImpact <= 0.4 and (tick() - lastParryTime) >= 0.1 then
                    lastParryTime = tick()
                    doParry()
                    Settings.Parries = Settings.Parries + 1
                end
            end
        end
    end)
end

