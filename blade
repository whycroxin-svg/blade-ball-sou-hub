local function updateBallESP()
    if not usingDrawing or not ballDrawings.ready then return end
    if not Settings.TopESP then
        ballDrawings.distText.Visible = false
        ballDrawings.speedText.Visible = false
        ballDrawings.tracer.Visible = false
        ballDrawings.ring.Visible = false
        return
    end
    local ball = getRealBall()
    if not ball then
        ballDrawings.distText.Visible = false
        ballDrawings.speedText.Visible = false
        ballDrawings.tracer.Visible = false
        ballDrawings.ring.Visible = false
        return
    end
    local char = LocalPlayer.Character
    if not char or not char:FindFirstChild("HumanoidRootPart") then return end
    local hrp = char.HumanoidRootPart
    local ballPos = ball.Position
    local screenPos, onScreen = Camera:WorldToViewportPoint(ballPos)
    if onScreen then
        local dist = math.floor((ballPos - hrp.Position).Magnitude)
        local spd = math.floor(ball.AssemblyLinearVelocity.Magnitude)
        
        if Settings.TopMesafeYazi then
            ballDrawings.distText.Text = dist .. "m"
            ballDrawings.distText.Position = Vector2.new(screenPos.X, screenPos.Y - 20)
            ballDrawings.distText.Visible = true
        else
            ballDrawings.distText.Visible = false
        end
        
        if Settings.TopHizYazi then
            ballDrawings.speedText.Text = spd .. " stud/s"
            ballDrawings.speedText.Position = Vector2.new(screenPos.X, screenPos.Y - 4)
            ballDrawings.speedText.Visible = true
        else
            ballDrawings.speedText.Visible = false
        end
        
        if Settings.TopCizgi then
            ballDrawings.tracer.From = Vector2.new(Camera.ViewportSize.X/2, Camera.ViewportSize.Y)
            ballDrawings.tracer.To = Vector2.new(screenPos.X, screenPos.Y)
            ballDrawings.tracer.Visible = true
        else
            ballDrawings.tracer.Visible = false
        end
        
        if Settings.HedefGostergesi and isTargeted() then
            ballDrawings.ring.Position = Vector2.new(screenPos.X, screenPos.Y)
            ballDrawings.ring.Radius = 25
            ballDrawings.ring.Color = Color3.fromRGB(255, 60, 60)
            ballDrawings.ring.Visible = true
        else
            ballDrawings.ring.Visible = false
        end
    else
        ballDrawings.distText.Visible = false
        ballDrawings.speedText.Visible = false
        ballDrawings.tracer.Visible = false
        ballDrawings.ring.Visible = false
    end
end

